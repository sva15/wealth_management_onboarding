# Copy to .env (never commit .env). Secrets stay out of source code.
APP_ENV=local
LOG_LEVEL=INFO

# Relational store (SQLite; swap for another SQLAlchemy URL later if needed)
DATABASE_URL=sqlite:///./data/app.db

# Graph store: "memory" (placeholder, no server needed) or "neo4j"
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Documents (local filesystem)
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_PROCESSOR_MODE=local   # "local_ocr" enables Tesseract OCR for scanned pages
MAX_UPLOAD_MB=20

# LLM: Amazon Bedrock is the only cloud dependency
USE_MOCK_BEDROCK=true
AWS_REGION=
BEDROCK_MODEL_ID=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
EXTRACTION_CONFIDENCE_THRESHOLD=0.7
# Placeholder only: embeddings are not implemented yet
EMBEDDINGS_MODE=placeholder
BEDROCK_EMBEDDING_MODEL_ID=

CORS_ORIGINS=http://localhost:5173

# Reconciliation: optional JSON policy (staleness days, severity thresholds) and a pinned evaluation date
RECONCILIATION_POLICY_PATH=
RECONCILIATION_AS_OF_DATE=
